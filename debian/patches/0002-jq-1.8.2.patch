-"# Apply f to composite entities recursively, and to atoms\n"
-"def walk(f):\n"
-"  def w:\n"
-"    if type == \"object\"\n"
-"    then map_values(w)\n"
-"    elif type == \"array\" then map(w)\n"
-"    else .\n"
-"    end\n"
-"    | f;\n"
-"  w;\n"
